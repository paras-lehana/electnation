# Election Yatra — Environment Variables
# Copy to .env.local and fill in real values from Google Cloud Console / Secret Manager.

# -----------------------------------------------------------------------------
# Google Cloud project
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=election-yatra
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# -----------------------------------------------------------------------------
# Gemini / Vertex AI
# -----------------------------------------------------------------------------
VERTEX_MODEL_CHAT=gemini-2.5-flash
VERTEX_MODEL_ANALYSIS=gemini-2.5-pro
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Maps, Places, Geocoding, Directions, Distance Matrix
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# -----------------------------------------------------------------------------
# OAuth (Calendar)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# YouTube Data API
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_SVEEP_PLAYLIST_ID=

# -----------------------------------------------------------------------------
# Translation, TTS, STT (use ADC via GOOGLE_APPLICATION_CREDENTIALS)
# -----------------------------------------------------------------------------
TRANSLATION_DEFAULT_SOURCE=en
TRANSLATION_SUPPORTED_LOCALES=en,hi,bn,ta,te,mr,gu,kn,ml,pa,ur

# -----------------------------------------------------------------------------
# Firebase
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=election-yatra
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# reCAPTCHA Enterprise
# -----------------------------------------------------------------------------
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_BYPASS=true
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# GA4 (server-side Measurement Protocol)
# -----------------------------------------------------------------------------
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
NODE_ENV=development
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
